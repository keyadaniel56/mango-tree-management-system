# ---------------------------------------------------------------------------
# Environment variables for a manually created Render web service
# (Dashboard -> New -> Web Service -> Language: Docker).
#
# Blueprint users do not need this file: render.yaml already defines everything
# and wires DB_* to the private MySQL service. Use this list only when you
# create the web service by hand and point it at an external MySQL server
# (Aiven, PlanetScale, Clever Cloud, ...).
#
# Paste the values in the Dashboard "Environment" tab. Anything marked
# <generate> must be created in the Dashboard, never committed to git.
# ---------------------------------------------------------------------------

APP_NAME=MangoTreeSchool
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=error
# <generate> `php artisan key:generate --show`, it must start with "base64:"
APP_KEY=base64:REPLACE_WITH_YOUR_OWN_KEY=
# Render injects RENDER_EXTERNAL_URL; set the final URL explicitly to be safe
APP_URL=https://mango-tree-management-system.onrender.com

DB_CONNECTION=mysql
DB_HOST=<your-mysql-host>
DB_PORT=3306
DB_DATABASE=schoolapi
DB_USERNAME=<your-mysql-user>
DB_PASSWORD=<generate>

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# auto = seed an empty database once, true = seed every boot, false = never
SEED_DATABASE=auto
MAX_RECORD_PER_PAGE=25

# Leave these empty unless you actually use mail/SMS/Pusher on Render
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=