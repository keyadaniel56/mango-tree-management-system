# ---------------------------------------------------------------------------
# Environment variables for the FREE Mango Tree deployment on Render.
#
# Render's free plan only covers Web Services (no managed MySQL, no durable
# disks), so MySQL runs on Aiven's free tier (real MySQL 8, TLS enforced):
#   https://aiven.io/free-mysql-database
#
# Two ways to deploy:
#   1. Blueprint (recommended) - "New -> Blueprint" in the Render dashboard,
#      link this repo and use render.yaml. Only the sync:false variables
#      below have to be filled in afterwards.
#   2. Manual - "New -> Web Service" (Language: Docker), then paste these
#      values in the Environment tab.
# ---------------------------------------------------------------------------

APP_NAME=MangoTreeSchool
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=error
# <generate> `php artisan key:generate --show`, it must start with "base64:"
APP_KEY=base64:REPLACE_WITH_YOUR_OWN_KEY=
# Render injects RENDER_EXTERNAL_URL; set the final URL explicitly to be safe
APP_URL=https://mango-tree-management-system.onrender.com

DB_CONNECTION=mysql
# Host / port from Aiven Console -> your service -> Overview -> Connection
# information (Service URI). Example host: <project>-<service>.aivencloud.com
DB_HOST=<aiven-service-hostname>.aivencloud.com
DB_PORT=<aiven-service-port>
DB_DATABASE=defaultdb
# IMPORTANT: create this user in the Aiven console with the
# mysql_native_password authentication method (PHP 7.2 cannot do the MySQL 8
# default caching_sha2_password). Grant it privileges on the app database.
DB_USERNAME=<aiven-app-user>
DB_PASSWORD=<generate-in-aiven>

# Note: the free Aiven tier exposes MySQL over plaintext TCP (no TLS offered),
# and the app runtime is PHP 7.2, which also cannot use caching_sha2_password.

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# auto = seed an empty database once, true = seed every boot, false = never
SEED_DATABASE=auto
MAX_RECORD_PER_PAGE=25

# Leave these empty unless you actually use mail/SMS/Pusher on Render
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=